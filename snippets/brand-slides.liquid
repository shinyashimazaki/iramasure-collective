{% doc %}
  Shared brand slide images from theme settings (hero).
  Falls back to built-in desktop/mobile assets, then section.blocks.

  @param {string} context - 'hero' or 'footer'
  @param {object} [section] - hero section (for block fallback + attributes)
{% enddoc %}

{% liquid
  assign context = context | default: 'hero'
  assign slide_count = 0
  for i in (1..4)
    assign image_id = 'brand_slide_' | append: i
    if settings[image_id] != blank
      assign slide_count = slide_count | plus: 1
    endif
  endfor

  assign use_settings = false
  if slide_count > 0
    assign use_settings = true
  endif

  assign use_assets = false
  if use_settings == false
    assign use_assets = true
    assign slide_count = 4
  endif

  if use_settings == false and use_assets == false and context == 'hero' and section != blank
    assign slide_count = section.blocks.size
  endif

  assign interval = settings.brand_slide_interval | default: 5
  assign asset_handles = 'brand-hero-01,brand-hero-02,brand-hero-03,brand-hero-04' | split: ','
%}

{% if slide_count > 0 %}
  <div
    class="brand-slides brand-slides--{{ context }}"
    style="--brand-slide-interval: {{ interval }}s;"
    data-brand-slides
    data-brand-slides-context="{{ context }}"
  >
    <div class="brand-slides__list" aria-hidden="true">
      {% if use_settings %}
        {% assign rendered = 0 %}
        {% for i in (1..4) %}
          {% liquid
            assign image_id = 'brand_slide_' | append: i
            assign mobile_id = 'brand_slide_' | append: i | append: '_mobile'
            assign credit_id = 'brand_slide_' | append: i | append: '_photographer'
            assign slide_image = settings[image_id]
            assign slide_mobile = settings[mobile_id]
            assign slide_credit = settings[credit_id]
            if slide_credit != blank
              unless slide_credit contains 'Photographer by'
                assign slide_credit = 'Photographer by ' | append: slide_credit
              endunless
            endif
          %}
          {% if slide_image != blank %}
            {% liquid
              assign rendered = rendered | plus: 1
              assign slide_loading = 'lazy'
              assign slide_priority = 'low'
              if rendered == 1 and context == 'hero'
                assign slide_loading = 'eager'
                assign slide_priority = 'high'
              endif
              assign slide_alt = slide_image.alt | default: shop.name
              assign is_first = false
              if rendered == 1
                assign is_first = true
              endif
            %}
            <div
              class="brand-slides__slide{% if is_first %} is-active{% endif %}"
              data-slide-index="{{ rendered | minus: 1 }}"
              {% if slide_credit != blank %}
                data-photographer="{{ slide_credit | escape }}"
              {% endif %}
            >
              {% if slide_mobile != blank %}
                <picture>
                  <source
                    media="(max-width: 749px)"
                    srcset="
                      {{ slide_mobile | image_url: width: 750 }} 750w,
                      {{ slide_mobile | image_url: width: 1100 }} 1100w,
                      {{ slide_mobile | image_url: width: 1500 }} 1500w
                    "
                    sizes="100vw"
                    width="{{ slide_mobile.width }}"
                    height="{{ slide_mobile.height }}"
                  >
                  {{
                    slide_image
                    | image_url: width: 3840
                    | image_tag:
                      class: 'brand-slides__image',
                      widths: '832, 1200, 1600, 1920, 2560, 3840',
                      sizes: '100vw',
                      loading: slide_loading,
                      fetchpriority: slide_priority,
                      alt: slide_alt
                  }}
                </picture>
              {% else %}
                {{
                  slide_image
                  | image_url: width: 3840
                  | image_tag:
                    class: 'brand-slides__image',
                    widths: '832, 1200, 1600, 1920, 2560, 3840',
                    sizes: '100vw',
                    loading: slide_loading,
                    fetchpriority: slide_priority,
                    alt: slide_alt
                }}
              {% endif %}
            </div>
          {% endif %}
        {% endfor %}
      {% elsif use_assets %}
        {% for handle in asset_handles %}
          {% liquid
            assign slide_loading = 'lazy'
            assign slide_priority = 'low'
            if forloop.first and context == 'hero'
              assign slide_loading = 'eager'
              assign slide_priority = 'high'
            endif
            assign credit_id = 'brand_slide_' | append: forloop.index | append: '_photographer'
            assign slide_credit = settings[credit_id] | default: 'YUTO YAMADA'
            unless slide_credit contains 'Photographer by'
              assign slide_credit = 'Photographer by ' | append: slide_credit
            endunless
            assign desktop_webp = handle | append: '-desktop.webp'
            assign desktop_jpg = handle | append: '-desktop.jpg'
            assign mobile_webp = handle | append: '-mobile.webp'
            assign mobile_jpg = handle | append: '-mobile.jpg'
          %}
          <div
            class="brand-slides__slide{% if forloop.first %} is-active{% endif %}"
            data-slide-index="{{ forloop.index0 }}"
            {% if slide_credit != blank %}
              data-photographer="{{ slide_credit | escape }}"
            {% endif %}
          >
            <picture>
              <source
                media="(max-width: 749px)"
                srcset="{{ mobile_webp | asset_url }}"
                type="image/webp"
                width="575"
                height="1024"
              >
              <source
                media="(max-width: 749px)"
                srcset="{{ mobile_jpg | asset_url }}"
                width="575"
                height="1024"
              >
              <source
                srcset="{{ desktop_webp | asset_url }}"
                type="image/webp"
                width="1024"
                height="576"
              >
              <img
                class="brand-slides__image"
                src="{{ desktop_jpg | asset_url }}"
                alt="{{ shop.name | escape }}"
                width="1024"
                height="576"
                loading="{{ slide_loading }}"
                {% if slide_priority == 'high' %}fetchpriority="high"{% endif %}
                decoding="async"
              >
            </picture>
          </div>
        {% endfor %}
      {% elsif context == 'hero' %}
        {% for block in section.blocks %}
          {% liquid
            assign slide_loading = 'lazy'
            assign slide_priority = 'low'
            if forloop.first
              assign slide_loading = 'eager'
              assign slide_priority = 'high'
            endif
          %}
          <div
            class="brand-slides__slide{% if forloop.first %} is-active{% endif %}"
            data-slide-index="{{ forloop.index0 }}"
            {% if block.settings.photographer != blank %}
              data-photographer="{{ block.settings.photographer | escape }}"
            {% endif %}
            {{ block.shopify_attributes }}
          >
            {% if block.settings.image != blank %}
              {% assign slide_alt = block.settings.image.alt | default: shop.name %}
              {{
                block.settings.image
                | image_url: width: 3840
                | image_tag:
                  class: 'brand-slides__image',
                  widths: '832, 1200, 1600, 1920, 2560, 3840',
                  sizes: '100vw',
                  loading: slide_loading,
                  fetchpriority: slide_priority,
                  alt: slide_alt
              }}
            {% else %}
              <div class="brand-slides__placeholder">
                {{ 'hero-apparel-1' | placeholder_svg_tag: 'brand-slides__placeholder-svg' }}
              </div>
            {% endif %}
          </div>
        {% endfor %}
      {% endif %}
    </div>

    <div class="brand-slides__overlay"></div>

    {% if context == 'hero' %}
      {% liquid
        assign first_photographer = ''
        if settings.brand_slide_1_photographer != blank
          assign first_photographer = settings.brand_slide_1_photographer
        elsif use_assets
          assign first_photographer = 'YUTO YAMADA'
        elsif use_settings == false and section != blank
          for block in section.blocks
            if forloop.first and block.settings.photographer != blank
              assign first_photographer = block.settings.photographer
            endif
          endfor
        endif
        if first_photographer != blank
          unless first_photographer contains 'Photographer by'
            assign first_photographer = 'Photographer by ' | append: first_photographer
          endunless
        endif
      %}
      <p
        class="home-hero__photographer brand-slides__photographer{% if first_photographer == blank %} is-empty{% endif %}"
        data-brand-slides-photographer
      >
        {{- first_photographer | escape -}}
      </p>
    {% endif %}

    {% if slide_count > 1 %}
      <div
        class="brand-slides__dots{% if context == 'hero' %} home-hero__dots{% endif %}"
        role="tablist"
        aria-label="{{ 'accessibility.slideshow' | t }}"
      >
        {% for i in (1..slide_count) %}
          <button
            type="button"
            class="brand-slides__dot{% if context == 'hero' %} home-hero__dot{% endif %}{% if forloop.first %} is-active{% endif %}"
            role="tab"
            aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
            data-brand-slide-dot="{{ forloop.index0 }}"
            aria-label="{{ 'accessibility.slide_status' | t: index: forloop.index, length: slide_count }}"
          ></button>
        {% endfor %}
      </div>
    {% endif %}
  </div>
{% endif %}

{% stylesheet %}
  .brand-slides {
    position: relative;
    overflow: hidden;
  }

  .brand-slides__list {
    position: absolute;
    inset: 0;
  }

  .brand-slides__slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 1.2s ease;
  }

  .brand-slides__slide.is-active {
    opacity: 1;
    z-index: 1;
  }

  .brand-slides__slide picture {
    width: 100%;
    height: 100%;
    display: block;
  }

  .brand-slides__image,
  .brand-slides__placeholder,
  .brand-slides__placeholder-svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .brand-slides__placeholder {
    background: #1a1a1a;
  }

  .brand-slides__overlay {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
  }

  .brand-slides--hero .brand-slides__overlay {
    background:
      linear-gradient(180deg, rgba(0, 0, 0, 0.35) 0%, rgba(0, 0, 0, 0.15) 40%, rgba(0, 0, 0, 0.55) 100%);
  }

  .brand-slides--footer .brand-slides__overlay {
    background:
      linear-gradient(180deg, rgba(0, 0, 0, 0.2) 0%, rgba(0, 0, 0, 0.45) 55%, rgba(31, 31, 31, 0.92) 100%);
  }

  .brand-slides__dots {
    position: absolute;
    z-index: 3;
    display: flex;
    gap: 0.45rem;
  }

  .brand-slides__dot {
    width: 7px;
    height: 7px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.35);
    cursor: pointer;
  }

  .brand-slides__dot.is-active {
    background: #fff;
  }

  .brand-slides--footer .brand-slides__dots {
    right: var(--page-margin, 1.5rem);
    bottom: 1.25rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .brand-slides__slide {
      transition: none;
    }
  }
{% endstylesheet %}
