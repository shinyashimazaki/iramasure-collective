{% doc %}
  Dedicated home-hero navigation that reuses the same mega menu markup as the site header
  (featured_products), so Category hover matches the sticky header.
{% enddoc %}

{% liquid
  assign menu = linklists[menu_handle]
  if menu == blank
    assign menu = linklists['main-menu']
  endif

  assign menu_content_type = 'featured_products'
  assign ratio = '4 / 5'
  assign image_border_radius = 0
%}

<nav
  class="home-hero__nav"
  data-home-hero-nav
  aria-label="{{ 'accessibility.header_navigation_label' | t }}"
>
  <div class="home-hero__nav-inner">
    <header-menu class="home-hero__header-menu header-menu" data-hydration-key="home-hero-menu">
      <div class="header-menu__inner">
        <div class="menu-list">
          {% capture children %}
            {% for link in menu.links %}
              <li
                role="presentation"
                class="menu-list__list-item"
                on:focus="/activate"
                on:blur="/deactivate"
                on:pointerenter="/activate"
                on:pointerleave="/deactivate"
              >
                <a
                  href="{{ link.url }}"
                  class="menu-list__link home-hero__nav-link{% if link.active %} menu-list__link--active{% endif %}"
                  {% if link.links != blank %}
                    aria-controls="HeroSubmenu-{{ forloop.index }}"
                    aria-haspopup="true"
                    aria-expanded="false"
                  {% endif %}
                  {% if link.current %}
                    aria-current="page"
                  {% endif %}
                  ref="menuitem"
                >
                  <span class="menu-list__link-title">{{ link.title | escape }}</span>
                </a>

                {% if link.links != blank %}
                  <div class="menu-list__submenu" ref="submenu[]">
                    <div
                      id="HeroSubmenu-{{ forloop.index }}"
                      class="menu-list__submenu-inner"
                    >
                      {% assign list_id = 'HeroMegaMenuList-' | append: forloop.index %}
                      <div class="mega-menu section section--full-width">
                        <div
                          class="mega-menu__grid"
                          data-menu-grid-id="{{ list_id }}"
                        >
                          {% render 'mega-menu-list',
                            parent_link: link,
                            id: list_id,
                            grid_columns_count: 6,
                            grid_columns_count_tablet: 4,
                            grid_columns_count_collection_images: 8,
                            menu_content_type: menu_content_type,
                            content_aspect_ratio: ratio,
                            image_border_radius: image_border_radius,
                            force_eager: true
                          %}
                        </div>
                      </div>
                    </div>
                  </div>
                {% endif %}
              </li>
            {% endfor %}
            <li
              class="menu-list__list-item"
              role="presentation"
              slot="more"
              on:focus="/activate"
              on:blur="/deactivate"
              on:pointerenter="/activate"
              on:pointerleave="/deactivate"
            >
              <button type="button" role="listitem" class="menu-list__link button-unstyled">
                <span class="menu-list__link-title">{{ 'actions.more' | t }}</span>
              </button>
            </li>
          {% endcapture %}

          {% render 'overflow-list',
            class: 'overflow-menu home-hero__overflow-menu',
            ref: 'overflowMenu',
            children: children,
            minimum-items: 2,
            attributes: 'data-skip-node-update'
          %}
        </div>
      </div>

      <script
        src="{{ 'header-menu.js' | asset_url }}"
        type="module"
        fetchpriority="low"
      ></script>
    </header-menu>

    <div class="home-hero__nav-actions">
      {% if localization.available_languages.size > 1 %}
        {% form 'localization', id: 'home-hero-localization' %}
          <div class="home-hero__lang">
            {% for language in localization.available_languages %}
              <button
                type="submit"
                name="locale_code"
                value="{{ language.iso_code }}"
                class="home-hero__lang-btn{% if language.iso_code == localization.language.iso_code %} is-active{% endif %}"
                {% if language.iso_code == localization.language.iso_code %}
                  aria-current="true"
                {% endif %}
              >
                {{ language.iso_code | upcase }}
              </button>
              {% unless forloop.last %}
                <span class="home-hero__lang-sep" aria-hidden="true">/</span>
              {% endunless %}
            {% endfor %}
          </div>
        {% endform %}
      {% endif %}

      {% if shop.customer_accounts_enabled %}
        <a
          class="home-hero__icon-link"
          href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}"
          aria-label="{{ 'content.account_title' | t }}"
        >
          <span class="svg-wrapper">
            {{ 'icon-account.svg' | inline_asset_content }}
          </span>
        </a>
      {% endif %}

      <a
        class="home-hero__icon-link"
        href="{{ routes.cart_url }}"
        aria-label="{{ 'accessibility.cart' | t | default: 'Cart' }}"
      >
        <span class="svg-wrapper">
          {{ 'icon-cart.svg' | inline_asset_content }}
        </span>
        {% if cart.item_count > 0 %}
          <span class="home-hero__cart-count">{{ cart.item_count }}</span>
        {% endif %}
      </a>
    </div>
  </div>
</nav>
