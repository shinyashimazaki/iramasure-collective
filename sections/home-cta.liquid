<section class="home-cta color-{{ section.settings.color_scheme }}">
  <div class="home-cta__inner">
    {% if section.settings.body != blank %}
      <div class="home-cta__body rte">
        {{ section.settings.body }}
      </div>
    {% endif %}

    {% liquid
      assign cta_label = 'home.cta.button_label' | t
      if cta_label == blank or cta_label == 'home.cta.button_label'
        assign cta_label = section.settings.button_label
      endif
      assign cta_link = section.settings.button_link | default: routes.all_products_collection_url
    %}
    {% if cta_label != blank and cta_link != blank %}
      <a class="home-cta__button" href="{{ cta_link }}">
        {{ cta_label | escape }}
      </a>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .home-cta {
    padding: clamp(4rem, 9vw, 7rem) 1.5rem clamp(5rem, 10vw, 8rem);
    background: var(--color-background);
    color: var(--color-foreground);
  }

  .home-cta__inner {
    max-width: 36rem;
    margin: 0 auto;
    text-align: center;
  }

  .home-cta__body {
    font-size: clamp(1.05rem, 1.7vw, 1.25rem);
    line-height: 1.6;
    letter-spacing: 0.03em;
  }

  .home-cta__body p {
    margin: 0 0 1.35em;
  }

  .home-cta__body p:last-child {
    margin-bottom: 0;
  }

  .home-cta__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: 2.25rem;
    min-height: 3rem;
    padding: 0 1.75rem;
    border: 1px solid currentColor;
    color: inherit;
    text-decoration: none;
    font-size: 0.85rem;
    letter-spacing: 0.16em;
    transition: background 0.2s ease, color 0.2s ease;
  }

  .home-cta__button:hover {
    background: var(--color-foreground);
    color: var(--color-background);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Home CTA",
  "tag": "div",
  "class": "section-home-cta",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "default": "<p>私たちは、常に同じ棚を並べ続けるだけではありません。<br>季節と出会いとともに、新しい作り手を探し、次の良品を見つけ続けています。</p><p>好奇心が湧いたら、旅をはじめましょう。</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label fallback",
      "default": "Shop all",
      "info": "Used only if locale home.cta.button_label is missing."
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link",
      "info": "Defaults to the All collection when blank."
    }
  ],
  "presets": [
    {
      "name": "Home CTA"
    }
  ]
}
{% endschema %}
