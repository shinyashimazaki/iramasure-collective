{% liquid
  assign cta_body = section.settings.body | strip
  assign cta_body_plain = cta_body | strip_html | strip
  if cta_body == blank or cta_body_plain == blank
    assign cta_body = 'home.cta.body_html' | t
  endif

  assign cta_label = section.settings.button_label
  if cta_label == blank
    assign cta_label = 'home.cta.button_label' | t
  endif
%}

<section class="home-cta color-{{ section.settings.color_scheme }}">
  <div class="home-cta__inner">
    {% if cta_body != blank %}
      <div class="home-cta__body rte">
        {{ cta_body }}
      </div>
    {% endif %}

    {% if cta_label != blank and section.settings.button_link != blank %}
      <a class="home-cta__button" href="{{ section.settings.button_link }}">
        {{ cta_label | escape }}
      </a>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .home-cta {
    padding: clamp(4rem, 9vw, 7rem) 1.5rem clamp(5rem, 10vw, 8rem);
    background: var(--color-background);
    color: var(--color-foreground);
  }

  .home-cta__inner {
    max-width: 36rem;
    margin: 0 auto;
    text-align: center;
  }

  .home-cta__body {
    font-size: clamp(0.95rem, 1.45vw, 1.05rem);
    line-height: 2;
    letter-spacing: 0.03em;
  }

  .home-cta__body p {
    margin: 0 0 1.35em;
  }

  .home-cta__body p:last-child {
    margin-bottom: 0;
  }

  .home-cta__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: 2.25rem;
    min-height: 3rem;
    padding: 0 1.75rem;
    border: 1px solid currentColor;
    color: inherit;
    text-decoration: none;
    font-size: 0.85rem;
    letter-spacing: 0.16em;
    transition: background 0.2s ease, color 0.2s ease;
  }

  .home-cta__button:hover {
    background: var(--color-foreground);
    color: var(--color-background);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Home CTA",
  "tag": "div",
  "class": "section-home-cta",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "default": "<p></p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": ""
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Home CTA"
    }
  ]
}
{% endschema %}
