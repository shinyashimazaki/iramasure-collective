{%- comment -%}
  Full-viewport hero with up to 4 autoplaying photo slides (WAZU-style).
{%- endcomment -%}

<section
  class="home-hero"
  style="--home-hero-interval: {{ section.settings.autoplay_speed }}s;"
  data-home-hero
>
  <div class="home-hero__slides" aria-hidden="true">
    {% for block in section.blocks %}
      <div
        class="home-hero__slide{% if forloop.first %} is-active{% endif %}"
        data-slide-index="{{ forloop.index0 }}"
        {% if block.settings.photographer != blank %}
          data-photographer="{{ block.settings.photographer | escape }}"
        {% endif %}
        {{ block.shopify_attributes }}
      >
        {% liquid
          assign slide_loading = 'lazy'
          assign slide_priority = 'low'
          if forloop.first
            assign slide_loading = 'eager'
            assign slide_priority = 'high'
          endif

          assign fallback_asset = ''
          assign fallback_alt = shop.name
          case forloop.index0
            when 0
              assign fallback_asset = 'home-hero/hero-01-fuji.jpg'
              assign fallback_alt = 'Mount Fuji at dawn, Japan'
            when 1
              assign fallback_asset = 'home-hero/hero-02-pagoda.jpg'
              assign fallback_alt = 'Pagoda overlooking Kyoto, Japan'
            when 2
              assign fallback_asset = 'home-hero/hero-03-alley.jpg'
              assign fallback_alt = 'Traditional Japanese street at night'
            when 3
              assign fallback_asset = 'home-hero/hero-04-torii.jpg'
              assign fallback_alt = 'Fushimi Inari torii gates, Kyoto'
          endcase
        %}

        {% if block.settings.image != blank %}
          {% assign slide_alt = block.settings.image.alt | default: fallback_alt %}
          {{
            block.settings.image
            | image_url: width: 3840
            | image_tag:
              class: 'home-hero__image',
              widths: '832, 1200, 1600, 1920, 2560, 3840',
              sizes: '100vw',
              loading: slide_loading,
              fetchpriority: slide_priority,
              alt: slide_alt
          }}
        {% elsif fallback_asset != blank %}
          <img
            class="home-hero__image"
            src="{{ fallback_asset | asset_url }}"
            alt="{{ fallback_alt | escape }}"
            loading="{{ slide_loading }}"
            fetchpriority="{{ slide_priority }}"
            width="2400"
            height="1350"
          >
        {% else %}
          <div class="home-hero__placeholder">
            {{ 'hero-apparel-1' | placeholder_svg_tag: 'home-hero__placeholder-svg' }}
          </div>
        {% endif %}
      </div>
    {% endfor %}

    {% if section.blocks.size == 0 %}
      <div class="home-hero__slide is-active">
        <div class="home-hero__placeholder">
          {{ 'hero-apparel-1' | placeholder_svg_tag: 'home-hero__placeholder-svg' }}
        </div>
      </div>
    {% endif %}
  </div>

  <div class="home-hero__overlay"></div>

  {% render 'home-hero-nav', menu_handle: section.settings.menu %}

  {% if section.settings.show_logo %}
    <div class="home-hero__logo-wrap">
      {% if settings.logo != blank %}
        <img
          class="home-hero__logo"
          src="{{ settings.logo | image_url: width: 720 }}"
          alt="{{ shop.name | escape }}"
          width="{{ settings.logo.width }}"
          height="{{ settings.logo.height }}"
          loading="eager"
        >
      {% else %}
        <img
          class="home-hero__logo"
          src="{{ 'logo.svg' | asset_url }}"
          alt="{{ shop.name | escape }}"
          width="293"
          height="67"
          loading="eager"
        >
      {% endif %}
    </div>
  {% endif %}

  {% liquid
    # Locale is source of truth so Git deploys win over stale theme-editor JSON
    assign hero_heading = 'home.hero.heading' | t
    if hero_heading == blank or hero_heading == 'home.hero.heading'
      assign hero_heading = section.settings.heading
    endif
  %}
  {% liquid
    assign first_photographer = ''
    for block in section.blocks
      if forloop.first and block.settings.photographer != blank
        assign first_photographer = block.settings.photographer
      endif
    endfor
  %}
  <p
    class="home-hero__photographer{% if first_photographer == blank %} is-empty{% endif %}"
    data-home-hero-photographer
  >
    {{- first_photographer | escape -}}
  </p>

  {% if hero_heading != blank %}
    <div class="home-hero__content">
      <h2 class="home-hero__heading">{{ hero_heading | escape }}</h2>
    </div>
  {% endif %}

  {% if section.blocks.size > 1 %}
    <div class="home-hero__dots" role="tablist" aria-label="{{ 'accessibility.slideshow' | t }}">
      {% for block in section.blocks %}
        <button
          type="button"
          class="home-hero__dot{% if forloop.first %} is-active{% endif %}"
          role="tab"
          aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
          data-hero-dot="{{ forloop.index0 }}"
          aria-label="{{ 'accessibility.slide_status' | t: index: forloop.index, length: section.blocks.size }}"
        ></button>
      {% endfor %}
    </div>
  {% endif %}
</section>

{% if section.blocks.size > 1 %}
  <script src="{{ 'home-hero.js' | asset_url }}" defer></script>
{% endif %}

{% stylesheet %}
  .home-hero {
    position: relative;
    width: 100%;
    min-height: 100svh;
    overflow: visible;
    color: #f7f4ef;
    background: #111;
  }

  .home-hero__slides {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .home-hero__slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 1.2s ease;
  }

  .home-hero__slide.is-active {
    opacity: 1;
    z-index: 1;
  }

  .home-hero__image,
  .home-hero__placeholder,
  .home-hero__placeholder-svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .home-hero__placeholder {
    background: #1a1a1a;
  }

  .home-hero__overlay {
    position: absolute;
    inset: 0;
    z-index: 2;
    background:
      linear-gradient(180deg, rgba(0, 0, 0, 0.35) 0%, rgba(0, 0, 0, 0.15) 40%, rgba(0, 0, 0, 0.55) 100%);
    pointer-events: none;
  }

  /* Hero nav positioning only — spacing/type shared via salon-header.css */
  .home-hero__nav {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 5;
    padding: var(--site-nav-pad-block) var(--site-nav-pad-inline);
    color: #f7f4ef;
    pointer-events: none;
  }

  .home-hero__nav-inner {
    pointer-events: auto;
  }

  .home-hero__header-menu {
    height: auto;
  }

  .home-hero__nav .lang-switcher,
  .home-hero__nav .lang-switcher__btn,
  .home-hero__nav .menu-list__link {
    color: inherit;
  }

  .home-hero__cart-count {
    position: absolute;
    top: 6px;
    right: 4px;
    min-width: 1rem;
    height: 1rem;
    padding: 0 0.2rem;
    border-radius: 999px;
    background: #f7f4ef;
    color: #111;
    font-size: 0.65rem;
    line-height: 1rem;
    text-align: center;
  }

  .home-hero__nav .menu-list__list-item:where(:not([slot='overflow'])) > .menu-list__submenu {
    position: fixed;
    top: var(--site-nav-height);
    left: 0;
    width: 100%;
    clip-path: none;
    z-index: 30;
    padding-inline: 0;
    background: var(--color-background, #fff);
    color: var(--color-foreground, #111);
  }

  .home-hero__nav .menu-list__submenu-inner {
    padding: 1.5rem var(--site-nav-pad-inline) 2rem;
    background: var(--color-background, #fff);
    color: var(--color-foreground, #111);
  }

  .home-hero__nav .mega-menu__link,
  .home-hero__nav .mega-menu__content {
    color: inherit;
  }

  @media screen and (max-width: 749px) {
    .home-hero__header-menu {
      display: none;
    }
  }

  .home-hero__logo-wrap {
    position: absolute;
    inset: 0;
    z-index: 3;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
  }

  .home-hero__logo {
    width: clamp(160px, 18vw, 280px);
    height: auto;
    filter: brightness(0) invert(1);
  }

  .home-hero__photographer {
    position: absolute;
    left: var(--site-nav-pad-inline, var(--page-margin, 1.5rem));
    bottom: 2.5rem;
    z-index: 3;
    margin: 0;
    max-width: min(18rem, 42vw);
    color: #f7f4ef;
    font-family: var(--font-body--family);
    font-size: 0.7rem;
    font-weight: 400;
    line-height: 1.4;
    letter-spacing: 0.04em;
    opacity: 0.72;
    pointer-events: none;
  }

  .home-hero__photographer.is-empty {
    visibility: hidden;
  }

  @media screen and (max-width: 749px) {
    .home-hero__photographer {
      bottom: 50%;
      max-width: none;
      white-space: nowrap;
      letter-spacing: 0.08em;
      transform: rotate(-90deg);
      transform-origin: left bottom;
    }
  }

  .home-hero__content {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    text-align: center;
    padding: 0 var(--site-nav-pad-inline, var(--page-margin, 1.5rem)) 2.5rem;
    pointer-events: none;
  }

  .home-hero__heading {
    margin: 0;
    max-width: min(36em, 92vw);
    font-family: var(--font-heading--family);
    font-size: clamp(0.95rem, 1.8vw, 1.2rem);
    font-weight: 400;
    line-height: 1.55;
    letter-spacing: 0;
    text-align: center;
  }

  .home-hero__dots {
    position: absolute;
    right: var(--site-nav-pad-inline, var(--page-margin, 1.5rem));
    bottom: 1.75rem;
    z-index: 3;
    display: flex;
    gap: 0.45rem;
  }

  .home-hero__dot {
    width: 7px;
    height: 7px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.35);
    cursor: pointer;
  }

  .home-hero__dot.is-active {
    background: #fff;
  }

  @media (prefers-reduced-motion: reduce) {
    .home-hero__slide {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Home hero",
  "tag": "div",
  "class": "section-home-hero",
  "max_blocks": 4,
  "settings": [
    {
      "type": "checkbox",
      "id": "show_logo",
      "label": "Show logo",
      "default": true
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading fallback",
      "default": "Begin the journey",
      "info": "Used only if the locale string home.hero.heading is missing."
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Hero menu",
      "default": "main-menu"
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Slide duration",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 5
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Photo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "photographer",
          "label": "Photographer",
          "info": "Shown small at the bottom left while this slide is active."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Home hero",
      "blocks": [
        { "type": "slide" },
        { "type": "slide" },
        { "type": "slide" },
        { "type": "slide" }
      ]
    }
  ]
}
{% endschema %}
