{%- comment -%}
  Full-viewport hero with up to 4 autoplaying photo slides (WAZU-style).
{%- endcomment -%}

<section
  class="home-hero"
  style="--home-hero-interval: {{ section.settings.autoplay_speed }}s;"
  data-home-hero
>
  <div class="home-hero__slides" aria-hidden="true">
    {% for block in section.blocks %}
      <div
        class="home-hero__slide{% if forloop.first %} is-active{% endif %}"
        data-slide-index="{{ forloop.index0 }}"
        {{ block.shopify_attributes }}
      >
        {% liquid
          assign slide_loading = 'lazy'
          assign slide_priority = 'low'
          if forloop.first
            assign slide_loading = 'eager'
            assign slide_priority = 'high'
          endif

          assign fallback_asset = ''
          assign fallback_alt = shop.name
          case forloop.index0
            when 0
              assign fallback_asset = 'home-hero/hero-01-fuji.jpg'
              assign fallback_alt = 'Mount Fuji at dawn, Japan'
            when 1
              assign fallback_asset = 'home-hero/hero-02-pagoda.jpg'
              assign fallback_alt = 'Pagoda overlooking Kyoto, Japan'
            when 2
              assign fallback_asset = 'home-hero/hero-03-alley.jpg'
              assign fallback_alt = 'Traditional Japanese street at night'
            when 3
              assign fallback_asset = 'home-hero/hero-04-torii.jpg'
              assign fallback_alt = 'Fushimi Inari torii gates, Kyoto'
          endcase
        %}

        {% if block.settings.image != blank %}
          {% assign slide_alt = block.settings.image.alt | default: fallback_alt %}
          {{
            block.settings.image
            | image_url: width: 3840
            | image_tag:
              class: 'home-hero__image',
              widths: '832, 1200, 1600, 1920, 2560, 3840',
              sizes: '100vw',
              loading: slide_loading,
              fetchpriority: slide_priority,
              alt: slide_alt
          }}
        {% elsif fallback_asset != blank %}
          <img
            class="home-hero__image"
            src="{{ fallback_asset | asset_url }}"
            alt="{{ fallback_alt | escape }}"
            loading="{{ slide_loading }}"
            fetchpriority="{{ slide_priority }}"
            width="2400"
            height="1350"
          >
        {% else %}
          <div class="home-hero__placeholder">
            {{ 'hero-apparel-1' | placeholder_svg_tag: 'home-hero__placeholder-svg' }}
          </div>
        {% endif %}
      </div>
    {% endfor %}

    {% if section.blocks.size == 0 %}
      <div class="home-hero__slide is-active">
        <div class="home-hero__placeholder">
          {{ 'hero-apparel-1' | placeholder_svg_tag: 'home-hero__placeholder-svg' }}
        </div>
      </div>
    {% endif %}
  </div>

  <div class="home-hero__overlay"></div>

  {% render 'home-hero-nav', menu_handle: section.settings.menu %}

  {% if section.settings.show_logo %}
    <div class="home-hero__logo-wrap">
      {% if settings.logo != blank %}
        <img
          class="home-hero__logo"
          src="{{ settings.logo | image_url: width: 720 }}"
          alt="{{ shop.name | escape }}"
          width="{{ settings.logo.width }}"
          height="{{ settings.logo.height }}"
          loading="eager"
        >
      {% else %}
        <img
          class="home-hero__logo"
          src="{{ 'logo.svg' | asset_url }}"
          alt="{{ shop.name | escape }}"
          width="293"
          height="67"
          loading="eager"
        >
      {% endif %}
    </div>
  {% endif %}

  {% if section.settings.heading != blank %}
    <div class="home-hero__content">
      <h2 class="home-hero__heading">{{ section.settings.heading | escape }}</h2>
    </div>
  {% endif %}

  {% if section.blocks.size > 1 %}
    <div class="home-hero__dots" role="tablist" aria-label="{{ 'accessibility.slideshow' | t }}">
      {% for block in section.blocks %}
        <button
          type="button"
          class="home-hero__dot{% if forloop.first %} is-active{% endif %}"
          role="tab"
          aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
          data-hero-dot="{{ forloop.index0 }}"
          aria-label="{{ 'accessibility.slide_status' | t: index: forloop.index, length: section.blocks.size }}"
        ></button>
      {% endfor %}
    </div>
  {% endif %}
</section>

{% if section.blocks.size > 1 %}
  <script src="{{ 'home-hero.js' | asset_url }}" defer></script>
{% endif %}

{% stylesheet %}
  .home-hero {
    position: relative;
    width: 100%;
    min-height: 100svh;
    overflow: visible;
    color: #f7f4ef;
    background: #111;
  }

  .home-hero__slides {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .home-hero__slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 1.2s ease;
  }

  .home-hero__slide.is-active {
    opacity: 1;
    z-index: 1;
  }

  .home-hero__image,
  .home-hero__placeholder,
  .home-hero__placeholder-svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .home-hero__placeholder {
    background: #1a1a1a;
  }

  .home-hero__overlay {
    position: absolute;
    inset: 0;
    z-index: 2;
    background:
      linear-gradient(180deg, rgba(0, 0, 0, 0.35) 0%, rgba(0, 0, 0, 0.15) 40%, rgba(0, 0, 0, 0.55) 100%);
    pointer-events: none;
  }

  /* Dedicated hero nav — separate from sticky site header */
  .home-hero__nav {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 5;
    padding: 20px clamp(1.25rem, 4vw, 2.5rem);
    color: #f7f4ef;
    pointer-events: none;
  }

  .home-hero__nav-inner {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: clamp(18px, 2vw, 28px);
    pointer-events: auto;
  }

  .home-hero__nav-list {
    display: none;
    align-items: center;
    gap: clamp(18px, 2vw, 28px);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .home-hero__nav-item {
    position: relative;
  }

  .home-hero__nav-link,
  .home-hero__lang-btn {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
    font-family: var(--font-body--family);
    font-size: 0.875rem;
    letter-spacing: 0.04em;
    text-decoration: none;
    cursor: pointer;
  }

  .home-hero__nav-actions {
    display: flex;
    align-items: center;
    gap: clamp(12px, 1.5vw, 20px);
  }

  .home-hero__lang {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .home-hero__lang-btn {
    opacity: 0.55;
  }

  .home-hero__lang-btn.is-active {
    opacity: 1;
  }

  .home-hero__lang-sep {
    opacity: 0.35;
  }

  .home-hero__icon-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    color: inherit;
    text-decoration: none;
  }

  .home-hero__icon-link .svg-wrapper,
  .home-hero__icon-link svg {
    width: 1.25rem;
    height: 1.25rem;
  }

  .home-hero__cart-count {
    position: absolute;
    top: 6px;
    right: 4px;
    min-width: 1rem;
    height: 1rem;
    padding: 0 0.2rem;
    border-radius: 999px;
    background: #f7f4ef;
    color: #111;
    font-size: 0.65rem;
    line-height: 1rem;
    text-align: center;
  }

  .home-hero__mega {
    display: none;
    position: absolute;
    top: calc(100% + 0.5rem);
    right: 0;
    min-width: min(72vw, 42rem);
    padding: 1rem;
    gap: 0.75rem;
    background: rgb(17 17 17 / 0.92);
    color: #f7f4ef;
  }

  .home-hero__nav-item--parent:hover .home-hero__mega,
  .home-hero__nav-item--parent:focus-within .home-hero__mega {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(7.5rem, 1fr));
  }

  .home-hero__mega-card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    color: inherit;
    text-decoration: none;
  }

  .home-hero__mega-image {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    display: block;
  }

  .home-hero__mega-title,
  .home-hero__mega-link {
    font-size: 0.8rem;
    letter-spacing: 0.03em;
    color: inherit;
    text-decoration: none;
  }

  @media screen and (min-width: 750px) {
    .home-hero__nav-list {
      display: flex;
    }
  }

  @media screen and (max-width: 749px) {
    .home-hero__nav {
      padding-inline: 1.25rem;
    }

    .home-hero__nav-list {
      display: flex;
      gap: 1rem;
      max-width: 52vw;
      overflow-x: auto;
      scrollbar-width: none;
    }

    .home-hero__nav-list::-webkit-scrollbar {
      display: none;
    }

    .home-hero__nav-item--parent .home-hero__mega {
      display: none !important;
    }

    .home-hero__nav-link {
      white-space: nowrap;
      font-size: 0.8rem;
    }
  }

  .home-hero__logo-wrap {
    position: absolute;
    inset: 0;
    z-index: 3;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
  }

  .home-hero__logo {
    width: clamp(160px, 18vw, 280px);
    height: auto;
    filter: brightness(0) invert(1);
  }

  .home-hero__content {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    text-align: center;
    padding: 0 1.5rem 2.5rem;
  }

  .home-hero__heading {
    margin: 0;
    max-width: min(36em, 92vw);
    font-family: var(--font-heading--family);
    font-size: clamp(0.95rem, 1.8vw, 1.2rem);
    font-weight: 400;
    line-height: 1.55;
    letter-spacing: 0;
  }

  .home-hero__dots {
    position: absolute;
    right: 1.25rem;
    bottom: 1.75rem;
    z-index: 3;
    display: flex;
    gap: 0.45rem;
  }

  .home-hero__dot {
    width: 7px;
    height: 7px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.35);
    cursor: pointer;
  }

  .home-hero__dot.is-active {
    background: #fff;
  }

  @media (prefers-reduced-motion: reduce) {
    .home-hero__slide {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Home hero",
  "tag": "div",
  "class": "section-home-hero",
  "max_blocks": 4,
  "settings": [
    {
      "type": "checkbox",
      "id": "show_logo",
      "label": "Show logo",
      "default": true
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "日本の良品との、一期一会。"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Hero menu",
      "default": "main-menu"
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Slide duration",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 5
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Photo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Home hero",
      "blocks": [
        { "type": "slide" },
        { "type": "slide" },
        { "type": "slide" },
        { "type": "slide" }
      ]
    }
  ]
}
{% endschema %}
