{%- comment -%}
  Fixed full-viewport hero. Content sections scroll over it.
  Slides: Theme settings → Brand slides.
{%- endcomment -%}

{% liquid
  assign brand_slide_count = 0
  for i in (1..4)
    assign image_id = 'brand_slide_' | append: i
    if settings[image_id] != blank
      assign brand_slide_count = brand_slide_count | plus: 1
    endif
  endfor
  if brand_slide_count == 0
    assign brand_slide_count = section.blocks.size
  endif
%}

<section class="home-hero" data-home-hero>
  <div class="home-hero__stage">
    {% render 'brand-slides', context: 'hero', section: section %}

    {% render 'home-hero-nav', menu_handle: section.settings.menu %}

    {% if section.settings.show_logo %}
      <div class="home-hero__logo-wrap">
        {% if settings.logo != blank %}
          <img
            class="home-hero__logo"
            src="{{ settings.logo | image_url: width: 720 }}"
            alt="{{ shop.name | escape }}"
            width="{{ settings.logo.width }}"
            height="{{ settings.logo.height }}"
            loading="eager"
          >
        {% else %}
          <img
            class="home-hero__logo"
            src="{{ 'logo.svg' | asset_url }}"
            alt="{{ shop.name | escape }}"
            width="293"
            height="67"
            loading="eager"
          >
        {% endif %}
      </div>
    {% endif %}

    {% liquid
      assign hero_heading = 'home.hero.heading' | t
      if hero_heading == blank or hero_heading == 'home.hero.heading'
        assign hero_heading = section.settings.heading
      endif
    %}

    {% if hero_heading != blank %}
      <div class="home-hero__content">
        <h2 class="home-hero__heading">{{ hero_heading | escape }}</h2>
      </div>
    {% endif %}
  </div>
</section>

{% if brand_slide_count > 1 %}
  <script src="{{ 'brand-slides.js' | asset_url }}" defer></script>
{% endif %}

{% stylesheet %}
  .home-hero {
    --home-hero-bottom-inset: 2.5rem;
    --home-hero-z: 0;

    position: relative;
    width: 100%;
    height: 100svh;
    margin: 0;
    color: #f7f4ef;
    background: transparent;
    /* Document-flow spacer; visual stage is fixed underneath scrolling content */
    pointer-events: none;
    z-index: var(--home-hero-z);
  }

  .home-hero__stage {
    position: fixed;
    inset: 0;
    z-index: var(--home-hero-z);
    width: 100%;
    height: 100svh;
    overflow: hidden;
    color: #f7f4ef;
    background: #111;
    pointer-events: none;
    transform: translateZ(0);
    will-change: opacity;
  }

  .home-hero__stage > * {
    pointer-events: auto;
  }

  /* Keep fixed stage until the spacer has left the viewport; then release for paint/perf */
  body.template-index.is-past-hero .home-hero__stage {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .home-hero__stage {
      position: absolute;
      will-change: auto;
    }

    body.template-index.is-past-hero .home-hero__stage {
      opacity: 1;
      visibility: visible;
    }
  }

  .home-hero .brand-slides {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  /* Following homepage sections scroll over the fixed hero */
  body.template-index #MainContent > .shopify-section:not(:has([data-home-hero])) {
    position: relative;
    z-index: 2;
  }

  body.template-index footer {
    position: relative;
    z-index: 2;
  }

  body.template-index.is-past-hero #header-group {
    z-index: 20;
  }

  .home-hero .brand-slides__dots.home-hero__dots {
    right: var(--site-nav-pad-inline, var(--page-margin, 1.5rem));
    bottom: var(--home-hero-bottom-inset);
  }

  /* Hero nav positioning only — spacing/type shared via salon-header.css */
  .home-hero__nav {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 5;
    padding: var(--site-nav-pad-block) var(--site-nav-pad-inline);
    color: #f7f4ef;
    pointer-events: none;
  }

  .home-hero__nav-inner {
    pointer-events: auto;
  }

  .home-hero__header-menu {
    height: auto;
  }

  .home-hero__nav .lang-switcher,
  .home-hero__nav .lang-switcher__btn,
  .home-hero__nav .menu-list__link {
    color: inherit;
  }

  .home-hero__cart-count {
    position: absolute;
    top: 6px;
    right: 4px;
    min-width: 1rem;
    height: 1rem;
    padding: 0 0.2rem;
    border-radius: 999px;
    background: #f7f4ef;
    color: #111;
    font-size: 0.65rem;
    line-height: 1rem;
    text-align: center;
  }

  .home-hero__nav .menu-list__list-item:where(:not([slot='overflow'])) > .menu-list__submenu {
    position: fixed;
    top: var(--site-nav-height);
    left: 0;
    width: 100%;
    clip-path: none;
    z-index: 30;
    padding-inline: 0;
    background: var(--color-background, #fff);
    color: var(--color-foreground, #111);
  }

  .home-hero__nav .menu-list__submenu-inner {
    padding: 1.5rem var(--site-nav-pad-inline) 2rem;
    background: var(--color-background, #fff);
    color: var(--color-foreground, #111);
  }

  .home-hero__nav .mega-menu__link,
  .home-hero__nav .mega-menu__content {
    color: inherit;
  }

  @media screen and (max-width: 749px) {
    .home-hero__header-menu {
      display: none;
    }
  }

  .home-hero__logo-wrap {
    position: absolute;
    inset: 0;
    z-index: 3;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
  }

  .home-hero__logo {
    width: clamp(160px, 18vw, 280px);
    height: auto;
    filter: brightness(0) invert(1);
  }

  .home-hero__photographer {
    position: absolute;
    left: var(--site-nav-pad-inline, var(--page-margin, 1.5rem));
    bottom: var(--home-hero-bottom-inset);
    z-index: 3;
    margin: 0;
    max-width: min(18rem, 42vw);
    color: #f7f4ef;
    font-family: var(--font-body--family);
    font-size: 0.7rem;
    font-weight: 400;
    line-height: 1;
    letter-spacing: 0.04em;
    opacity: 0.72;
    pointer-events: none;
  }

  .home-hero__photographer.is-empty {
    visibility: hidden;
  }

  @media screen and (max-width: 749px) {
    .home-hero__photographer {
      max-width: none;
      white-space: nowrap;
      letter-spacing: 0.08em;
      transform: rotate(-90deg);
      transform-origin: left bottom;
    }
  }

  .home-hero__content {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    text-align: center;
    padding: 0 var(--site-nav-pad-inline, var(--page-margin, 1.5rem)) var(--home-hero-bottom-inset);
    pointer-events: none;
  }

  .home-hero__heading {
    margin: 0;
    max-width: min(36em, 92vw);
    font-family: var(--font-heading--family);
    font-size: clamp(0.95rem, 1.8vw, 1.2rem);
    font-weight: 400;
    line-height: 1;
    letter-spacing: 0;
    text-align: center;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Home hero",
  "tag": "div",
  "class": "section-home-hero",
  "max_blocks": 4,
  "settings": [
    {
      "type": "paragraph",
      "content": "Photos are managed in Theme settings → Brand slides. The hero stays fixed while page content scrolls over it."
    },
    {
      "type": "checkbox",
      "id": "show_logo",
      "label": "Show logo",
      "default": true
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading fallback",
      "default": "Begin the journey",
      "info": "Used only if the locale string home.hero.heading is missing."
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Hero menu",
      "default": "main-menu"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Photo (fallback)",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "photographer",
          "label": "Photographer"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Home hero"
    }
  ]
}
{% endschema %}
