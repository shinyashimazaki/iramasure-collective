{%- comment -%}
  Full-viewport hero with up to 4 autoplaying photo slides (WAZU-style).
{%- endcomment -%}

<section
  class="home-hero"
  style="--home-hero-interval: {{ section.settings.autoplay_speed }}s;"
  data-home-hero
>
  <div class="home-hero__slides" aria-hidden="true">
    {% for block in section.blocks %}
      <div
        class="home-hero__slide{% if forloop.first %} is-active{% endif %}"
        data-slide-index="{{ forloop.index0 }}"
        {{ block.shopify_attributes }}
      >
        {% liquid
          assign slide_loading = 'lazy'
          assign slide_priority = 'low'
          if forloop.first
            assign slide_loading = 'eager'
            assign slide_priority = 'high'
          endif

          assign fallback_asset = ''
          assign fallback_alt = shop.name
          case forloop.index0
            when 0
              assign fallback_asset = 'home-hero/hero-01-fuji.jpg'
              assign fallback_alt = 'Mount Fuji at dawn, Japan'
            when 1
              assign fallback_asset = 'home-hero/hero-02-pagoda.jpg'
              assign fallback_alt = 'Pagoda overlooking Kyoto, Japan'
            when 2
              assign fallback_asset = 'home-hero/hero-03-alley.jpg'
              assign fallback_alt = 'Traditional Japanese street at night'
            when 3
              assign fallback_asset = 'home-hero/hero-04-torii.jpg'
              assign fallback_alt = 'Fushimi Inari torii gates, Kyoto'
          endcase
        %}

        {% if block.settings.image != blank %}
          {% assign slide_alt = block.settings.image.alt | default: fallback_alt %}
          {{
            block.settings.image
            | image_url: width: 3840
            | image_tag:
              class: 'home-hero__image',
              widths: '832, 1200, 1600, 1920, 2560, 3840',
              sizes: '100vw',
              loading: slide_loading,
              fetchpriority: slide_priority,
              alt: slide_alt
          }}
        {% elsif fallback_asset != blank %}
          <img
            class="home-hero__image"
            src="{{ fallback_asset | asset_url }}"
            alt="{{ fallback_alt | escape }}"
            loading="{{ slide_loading }}"
            fetchpriority="{{ slide_priority }}"
            width="2400"
            height="1350"
          >
        {% else %}
          <div class="home-hero__placeholder">
            {{ 'hero-apparel-1' | placeholder_svg_tag: 'home-hero__placeholder-svg' }}
          </div>
        {% endif %}
      </div>
    {% endfor %}

    {% if section.blocks.size == 0 %}
      <div class="home-hero__slide is-active">
        <div class="home-hero__placeholder">
          {{ 'hero-apparel-1' | placeholder_svg_tag: 'home-hero__placeholder-svg' }}
        </div>
      </div>
    {% endif %}
  </div>

  <div class="home-hero__overlay"></div>

  <div class="home-hero__content">
    {% if section.settings.show_logo %}
      {% if settings.logo != blank %}
        <img
          class="home-hero__logo"
          src="{{ settings.logo | image_url: width: 720 }}"
          alt="{{ shop.name | escape }}"
          width="{{ settings.logo.width }}"
          height="{{ settings.logo.height }}"
          loading="eager"
        >
      {% else %}
        <img
          class="home-hero__logo"
          src="{{ 'logo.svg' | asset_url }}"
          alt="{{ shop.name | escape }}"
          width="293"
          height="67"
          loading="eager"
        >
      {% endif %}
    {% endif %}

    {% if section.settings.heading != blank %}
      <h2 class="home-hero__heading">{{ section.settings.heading | escape }}</h2>
    {% endif %}
  </div>

  {% if section.settings.show_scroll_hint %}
    <div class="home-hero__scroll" aria-hidden="true">
      <span class="home-hero__scroll-line"></span>
    </div>
  {% endif %}

  {% if section.blocks.size > 1 %}
    <div class="home-hero__dots" role="tablist" aria-label="{{ 'accessibility.slideshow' | t }}">
      {% for block in section.blocks %}
        <button
          type="button"
          class="home-hero__dot{% if forloop.first %} is-active{% endif %}"
          role="tab"
          aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
          data-hero-dot="{{ forloop.index0 }}"
          aria-label="{{ 'accessibility.slide_status' | t: index: forloop.index, length: section.blocks.size }}"
        ></button>
      {% endfor %}
    </div>
  {% endif %}
</section>

{% if section.blocks.size > 1 %}
  <script src="{{ 'home-hero.js' | asset_url }}" defer></script>
{% endif %}

{% stylesheet %}
  .home-hero {
    position: relative;
    width: 100%;
    min-height: 100svh;
    overflow: hidden;
    color: #f7f4ef;
    background: #111;
  }

  .home-hero__slides {
    position: absolute;
    inset: 0;
  }

  .home-hero__slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 1.2s ease;
  }

  .home-hero__slide.is-active {
    opacity: 1;
    z-index: 1;
  }

  .home-hero__image,
  .home-hero__placeholder,
  .home-hero__placeholder-svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .home-hero__placeholder {
    background: #1a1a1a;
  }

  .home-hero__overlay {
    position: absolute;
    inset: 0;
    z-index: 2;
    background:
      linear-gradient(180deg, rgba(0, 0, 0, 0.35) 0%, rgba(0, 0, 0, 0.15) 40%, rgba(0, 0, 0, 0.55) 100%);
    pointer-events: none;
  }

  .home-hero__content {
    position: relative;
    z-index: 3;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    text-align: center;
    gap: 1.25rem;
    /* Sit just above the animated scroll bar (bottom: 1.75rem + 56px) */
    padding: 6rem 1.5rem calc(1.75rem + 56px + 1.5rem);
  }

  .home-hero__logo {
    width: clamp(160px, 18vw, 280px);
    height: auto;
    filter: brightness(0) invert(1);
  }

  .home-hero__heading {
    margin: 1.75em 0 0;
    max-width: 18em;
    font-family: var(--font-heading--family);
    font-size: clamp(0.95rem, 1.8vw, 1.2rem);
    font-weight: 400;
    line-height: 1.55;
    letter-spacing: 0;
  }

  .home-hero__scroll {
    position: absolute;
    left: 50%;
    bottom: 1.75rem;
    z-index: 3;
    transform: translateX(-50%);
    width: 1px;
    height: 56px;
    overflow: hidden;
  }

  .home-hero__scroll-line {
    display: block;
    width: 1px;
    height: 100%;
    background: currentColor;
    transform-origin: top;
    animation: home-hero-scroll 1.8s ease-in-out infinite;
  }

  @keyframes home-hero-scroll {
    0% {
      transform: scaleY(0);
      opacity: 0;
    }
    30% {
      opacity: 1;
    }
    100% {
      transform: scaleY(1);
      opacity: 0;
    }
  }

  .home-hero__dots {
    position: absolute;
    right: 1.25rem;
    bottom: 1.75rem;
    z-index: 3;
    display: flex;
    gap: 0.45rem;
  }

  .home-hero__dot {
    width: 7px;
    height: 7px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.35);
    cursor: pointer;
  }

  .home-hero__dot.is-active {
    background: #fff;
  }

  @media (prefers-reduced-motion: reduce) {
    .home-hero__slide {
      transition: none;
    }

    .home-hero__scroll-line {
      animation: none;
      opacity: 0.6;
      transform: scaleY(1);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Home hero",
  "tag": "div",
  "class": "section-home-hero",
  "max_blocks": 4,
  "settings": [
    {
      "type": "checkbox",
      "id": "show_logo",
      "label": "Show logo",
      "default": true
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "日本の良品との、一期一会。"
    },
    {
      "type": "checkbox",
      "id": "show_scroll_hint",
      "label": "Show scroll hint",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Slide duration",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 5
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Photo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Home hero",
      "blocks": [
        { "type": "slide" },
        { "type": "slide" },
        { "type": "slide" },
        { "type": "slide" }
      ]
    }
  ]
}
{% endschema %}
