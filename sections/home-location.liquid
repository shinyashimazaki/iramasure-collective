<section class="home-location color-{{ section.settings.color_scheme }}">
  <div class="home-location__inner">
    {% if section.settings.heading != blank %}
      <h3 class="home-location__heading">{{ section.settings.heading | escape }}</h3>
    {% endif %}
  </div>

  {% liquid
    assign slide_count = 0
    for block in section.blocks
      if block.type == 'slide' and block.settings.image != blank
        assign slide_count = slide_count | plus: 1
      endif
    endfor
    assign use_fallback = false
    if slide_count == 0
      assign use_fallback = true
      assign fallback_slides = 'shop-slide-01,shop-slide-02,shop-slide-03,shop-slide-04' | split: ','
      assign slide_count = fallback_slides.size
    endif
  %}

  {% if slide_count > 0 %}
    <div
      class="home-location__gallery"
      data-home-location-gallery
      aria-label="{{ section.settings.heading | default: 'Visit the Shop' | escape }}"
    >
      <div class="home-location__track" data-home-location-track>
        {% if use_fallback %}
          {% for handle in fallback_slides %}
            <figure class="home-location__slide" data-home-location-slide>
              <picture>
                <source
                  srcset="{{ handle | append: '.webp' | asset_url }}"
                  type="image/webp"
                  width="615"
                  height="900"
                >
                <img
                  class="home-location__image"
                  src="{{ handle | append: '.jpg' | asset_url }}"
                  alt="{{ section.settings.heading | default: 'Shop' | escape }}"
                  width="615"
                  height="900"
                  loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                  {% if forloop.first %}fetchpriority="high"{% endif %}
                  decoding="async"
                >
              </picture>
            </figure>
          {% endfor %}
        {% else %}
          {% for block in section.blocks %}
            {% if block.type == 'slide' and block.settings.image != blank %}
              {% liquid
                if forloop.first
                  assign slide_loading = 'eager'
                else
                  assign slide_loading = 'lazy'
                endif
                assign slide_alt = block.settings.alt | default: section.settings.heading
              %}
              <figure class="home-location__slide" data-home-location-slide {{ block.shopify_attributes }}>
                {{
                  block.settings.image
                  | image_url: width: 900
                  | image_tag:
                    class: 'home-location__image',
                    widths: '400, 615, 900',
                    sizes: '(min-width: 750px) 280px, 70vw',
                    alt: slide_alt,
                    loading: slide_loading
                }}
              </figure>
            {% endif %}
          {% endfor %}
        {% endif %}
      </div>

      {% if slide_count > 1 %}
        <div class="home-location__dots" role="tablist" aria-label="{{ 'accessibility.slideshow' | t }}">
          {% for i in (1..slide_count) %}
            <button
              type="button"
              class="home-location__dot{% if forloop.first %} is-active{% endif %}"
              data-home-location-dot
              role="tab"
              aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
              aria-label="{{ 'accessibility.slide_status' | t: index: forloop.index, length: slide_count }}"
            ></button>
          {% endfor %}
        </div>
      {% endif %}
    </div>
  {% endif %}

  <div class="home-location__inner home-location__inner--details">
    <div class="home-location__grid">
      <div class="home-location__address">
        {% if section.settings.address != blank %}
          <div class="home-location__text">
            {{ section.settings.address }}
          </div>
        {% endif %}
      </div>

      <div class="home-location__hours">
        {% if section.settings.hours != blank %}
          <div class="home-location__text">
            {{ section.settings.hours }}
          </div>
        {% endif %}
      </div>
    </div>

    {% if section.settings.map_link != blank %}
      <a
        class="home-location__link"
        href="{{ section.settings.map_link }}"
        target="_blank"
        rel="noopener noreferrer"
      >
        {{ section.settings.map_label | default: 'Open in Maps' | escape }}
      </a>
    {% endif %}
  </div>
</section>

{% if slide_count > 1 %}
  <script src="{{ 'home-location.js' | asset_url }}" defer></script>
{% endif %}

{% stylesheet %}
  .home-location {
    padding: clamp(4rem, 8vw, 6.5rem) 0;
    background: var(--color-background);
    color: var(--color-foreground);
  }

  .home-location__inner {
    max-width: 40rem;
    margin: 0 auto;
    padding-inline: var(--page-margin, 1.5rem);
    text-align: left;
  }

  .home-location__inner--details {
    margin-top: clamp(1.75rem, 4vw, 2.5rem);
  }

  .home-location__heading {
    margin: 0 0 1.75rem;
    font-family: var(--font-heading--family);
    font-size: clamp(1.3rem, 2.6vw, 1.75rem);
    font-weight: 400;
    line-height: 1.55;
    letter-spacing: 0.04em;
  }

  .home-location__gallery {
    position: relative;
    width: min(100%, 56rem);
    margin-inline: auto;
  }

  .home-location__track {
    display: flex;
    gap: 0.75rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--page-margin, 1.5rem);
    padding-inline: var(--page-margin, 1.5rem);
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }

  .home-location__track::-webkit-scrollbar {
    display: none;
  }

  .home-location__slide {
    flex: 0 0 min(70vw, 17.5rem);
    margin: 0;
    scroll-snap-align: start;
    aspect-ratio: 2 / 3;
    overflow: hidden;
    background: #f0eeea;
  }

  @media screen and (min-width: 750px) {
    .home-location__slide {
      flex-basis: min(28vw, 17.5rem);
    }
  }

  .home-location__image,
  .home-location__slide picture,
  .home-location__slide img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .home-location__dots {
    display: flex;
    justify-content: center;
    gap: 0.45rem;
    margin-top: 1.25rem;
    padding-inline: var(--page-margin, 1.5rem);
  }

  .home-location__dot {
    width: 7px;
    height: 7px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: rgb(var(--color-foreground-rgb, 0 0 0) / 0.28);
    cursor: pointer;
  }

  .home-location__dot.is-active {
    background: rgb(var(--color-foreground-rgb, 0 0 0) / 0.85);
  }

  .home-location__grid {
    display: grid;
    gap: 1.75rem;
  }

  @media screen and (min-width: 750px) {
    .home-location__grid {
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
    }
  }

  .home-location__text {
    font-size: clamp(1rem, 1.5vw, 1.125rem);
    line-height: 1.75;
    letter-spacing: 0.02em;
  }

  .home-location__text p {
    margin: 0;
  }

  .home-location__link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: 2rem;
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 0.2em;
    font-size: 0.9rem;
    letter-spacing: 0.04em;
  }

  .home-location__link:hover {
    opacity: 0.7;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Home location",
  "tag": "div",
  "class": "section-home-location",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Visit the Shop"
    },
    {
      "type": "richtext",
      "id": "address",
      "label": "Address",
      "default": "<p>Winterfeldtstraße 13<br/>10781 Berlin</p>"
    },
    {
      "type": "richtext",
      "id": "hours",
      "label": "Opening hours",
      "default": "<p>Tue – Wed: 09:00–19:00<br/>Thu – Fri: 10:00–19:00<br/>Sat: 10:00–18:00<br/>Mon, Sun: Closed</p>"
    },
    {
      "type": "url",
      "id": "map_link",
      "label": "Map link"
    },
    {
      "type": "text",
      "id": "map_label",
      "label": "Map link label",
      "default": "Open in Maps"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Shop photo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Alt text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Home location"
    }
  ]
}
{% endschema %}
