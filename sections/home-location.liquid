<section class="home-location color-{{ section.settings.color_scheme }}">
  <div class="home-location__inner">
    {% if section.settings.heading != blank %}
      <h3 class="home-location__heading">{{ section.settings.heading | escape }}</h3>
    {% endif %}

    <div class="home-location__grid">
      <div class="home-location__address">
        {% if section.settings.address != blank %}
          <div class="home-location__text">
            {{ section.settings.address }}
          </div>
        {% endif %}
      </div>

      <div class="home-location__hours">
        {% if section.settings.hours != blank %}
          <div class="home-location__text">
            {{ section.settings.hours }}
          </div>
        {% endif %}
      </div>
    </div>

    {% if section.settings.map_link != blank %}
      <a
        class="home-location__link"
        href="{{ section.settings.map_link }}"
        target="_blank"
        rel="noopener noreferrer"
      >
        {{ section.settings.map_label | default: 'Open in Maps' | escape }}
        <span aria-hidden="true">↗</span>
      </a>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .home-location {
    padding: clamp(4rem, 8vw, 6.5rem) var(--page-margin, 1.5rem);
    background: var(--color-background);
    color: var(--color-foreground);
  }

  .home-location__inner {
    max-width: 40rem;
    margin: 0 auto;
    text-align: left;
  }

  .home-location__heading {
    margin: 0 0 1.75rem;
    font-family: var(--font-heading--family);
    font-size: clamp(1.3rem, 2.6vw, 1.75rem);
    font-weight: 400;
    line-height: 1.55;
    letter-spacing: 0.04em;
  }

  .home-location__grid {
    display: grid;
    gap: 1.75rem;
  }

  @media screen and (min-width: 750px) {
    .home-location__grid {
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
    }
  }

  .home-location__text {
    font-size: clamp(1rem, 1.5vw, 1.125rem);
    line-height: 1.75;
    letter-spacing: 0.02em;
  }

  .home-location__text p {
    margin: 0;
  }

  .home-location__link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: 2rem;
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 0.2em;
    font-size: 0.9rem;
    letter-spacing: 0.04em;
  }

  .home-location__link:hover {
    opacity: 0.7;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Home location",
  "tag": "div",
  "class": "section-home-location",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Visit the Shop"
    },
    {
      "type": "richtext",
      "id": "address",
      "label": "Address",
      "default": "<p>Winterfeldtstraße 13<br/>10781 Berlin</p>"
    },
    {
      "type": "richtext",
      "id": "hours",
      "label": "Opening hours",
      "default": "<p>Tue – Wed: 09:00–19:00<br/>Thu – Fri: 10:00–19:00<br/>Sat: 10:00–18:00<br/>Mon, Sun: Closed</p>"
    },
    {
      "type": "url",
      "id": "map_link",
      "label": "Map link"
    },
    {
      "type": "text",
      "id": "map_label",
      "label": "Map link label",
      "default": "Open in Maps"
    }
  ],
  "presets": [
    {
      "name": "Home location"
    }
  ]
}
{% endschema %}
