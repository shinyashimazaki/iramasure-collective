<section class="home-location color-{{ section.settings.color_scheme }}">
  <div class="home-location__inner">
    {% if section.settings.heading != blank %}
      <h3 class="home-location__heading">{{ section.settings.heading | escape }}</h3>
    {% endif %}
  </div>

  {% liquid
    assign slide_count = 0
    for block in section.blocks
      if block.type == 'slide' and block.settings.image != blank
        assign slide_count = slide_count | plus: 1
      endif
    endfor
    assign use_fallback = false
    if slide_count == 0
      assign use_fallback = true
      assign fallback_slides = 'shop-slide-02,shop-slide-01,shop-slide-03,shop-slide-04' | split: ','
      assign slide_count = fallback_slides.size
    endif
  %}

  {% if slide_count > 0 %}
    <div
      class="home-location__gallery"
      data-home-location-gallery
      aria-label="{{ section.settings.heading | default: 'Visit the Shop' | escape }}"
    >
      {% if slide_count > 1 %}
        <button
          type="button"
          class="home-location__nav home-location__nav--prev"
          data-home-location-prev
          aria-label="{{ 'accessibility.slideshow_previous' | t }}"
        >
          <span aria-hidden="true">‹</span>
        </button>
      {% endif %}

      <div class="home-location__viewport">
        <div class="home-location__track" data-home-location-track>
          {% if use_fallback %}
            {% for handle in fallback_slides %}
              <figure class="home-location__slide" data-home-location-slide>
                <picture>
                  <source
                    srcset="{{ handle | append: '.webp' | asset_url }}"
                    type="image/webp"
                    width="700"
                    height="1024"
                  >
                  <img
                    class="home-location__image"
                    src="{{ handle | append: '.jpg' | asset_url }}"
                    alt="{{ section.settings.heading | default: 'Shop' | escape }}"
                    width="700"
                    height="1024"
                    loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                    {% if forloop.first %}fetchpriority="high"{% endif %}
                    decoding="async"
                  >
                </picture>
              </figure>
            {% endfor %}
          {% else %}
            {% for block in section.blocks %}
              {% if block.type == 'slide' and block.settings.image != blank %}
                {% liquid
                  if forloop.first
                    assign slide_loading = 'eager'
                  else
                    assign slide_loading = 'lazy'
                  endif
                  assign slide_alt = block.settings.alt | default: section.settings.heading
                %}
                <figure class="home-location__slide" data-home-location-slide {{ block.shopify_attributes }}>
                  {{
                    block.settings.image
                    | image_url: width: 1400
                    | image_tag:
                      class: 'home-location__image',
                      widths: '700, 1000, 1400',
                      sizes: '(min-width: 750px) 420px, 70vw',
                      alt: slide_alt,
                      loading: slide_loading
                  }}
                </figure>
              {% endif %}
            {% endfor %}
          {% endif %}
        </div>
      </div>

      {% if slide_count > 1 %}
        <button
          type="button"
          class="home-location__nav home-location__nav--next"
          data-home-location-next
          aria-label="{{ 'accessibility.slideshow_next' | t }}"
        >
          <span aria-hidden="true">›</span>
        </button>

        <div class="home-location__dots" role="tablist" aria-label="{{ 'accessibility.slideshow' | t }}">
          {% for i in (1..slide_count) %}
            <button
              type="button"
              class="home-location__dot{% if forloop.first %} is-active{% endif %}"
              data-home-location-dot
              role="tab"
              aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
              aria-label="{{ 'accessibility.slide_status' | t: index: forloop.index, length: slide_count }}"
            ></button>
          {% endfor %}
        </div>
      {% endif %}
    </div>
  {% endif %}

  <div class="home-location__inner home-location__inner--details">
    <div class="home-location__grid">
      <div class="home-location__address">
        {% if section.settings.address != blank %}
          <div class="home-location__text">
            {{ section.settings.address }}
          </div>
        {% endif %}
      </div>

      <div class="home-location__hours">
        {% if section.settings.hours != blank %}
          <div class="home-location__text">
            {{ section.settings.hours }}
          </div>
        {% endif %}
      </div>
    </div>

    {% if section.settings.map_link != blank %}
      <a
        class="home-location__link"
        href="{{ section.settings.map_link }}"
        target="_blank"
        rel="noopener noreferrer"
      >
        {{ section.settings.map_label | default: 'Open in Maps' | escape }}
      </a>
    {% endif %}
  </div>
</section>

{% if slide_count > 1 %}
  <script src="{{ 'home-location.js' | asset_url }}" defer></script>
{% endif %}

{% stylesheet %}
  .home-location {
    padding: clamp(4rem, 8vw, 6.5rem) 0;
    background: var(--color-background);
    color: var(--color-foreground);
  }

  .home-location__inner {
    max-width: 40rem;
    margin: 0 auto;
    padding-inline: var(--page-margin, 1.5rem);
    text-align: left;
  }

  .home-location__inner--details {
    margin-top: clamp(1.75rem, 4vw, 2.5rem);
  }

  .home-location__heading {
    margin: 0 0 1.75rem;
    font-family: var(--font-heading--family);
    font-size: clamp(1.3rem, 2.6vw, 1.75rem);
    font-weight: 400;
    line-height: 1.55;
    letter-spacing: 0.04em;
  }

  .home-location__gallery {
    position: relative;
    width: min(100%, 56rem);
    margin-inline: auto;
  }

  .home-location__viewport {
    overflow: hidden;
  }

  .home-location__track {
    display: flex;
    gap: 0.75rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--page-margin, 1.5rem);
    padding-inline: var(--page-margin, 1.5rem);
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }

  .home-location__track::-webkit-scrollbar {
    display: none;
  }

  .home-location__slide {
    flex: 0 0 min(72vw, 20rem);
    margin: 0;
    scroll-snap-align: start;
    aspect-ratio: 700 / 1024;
    overflow: hidden;
    background: #f0eeea;
  }

  .home-location__image,
  .home-location__slide picture,
  .home-location__slide img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .home-location__nav {
    display: none;
  }

  .home-location__dots {
    display: flex;
    justify-content: center;
    gap: 0.45rem;
    margin-top: 1.25rem;
    padding-inline: var(--page-margin, 1.5rem);
  }

  .home-location__dot {
    width: 7px;
    height: 7px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: rgb(var(--color-foreground-rgb, 0 0 0) / 0.28);
    cursor: pointer;
  }

  .home-location__dot.is-active {
    background: rgb(var(--color-foreground-rgb, 0 0 0) / 0.85);
  }

  @media screen and (min-width: 750px) {
    .home-location__gallery {
      width: min(100% - 2 * var(--page-margin, 1.5rem), 26rem);
      display: grid;
      grid-template-columns: auto 1fr auto;
      grid-template-areas:
        'prev viewport next'
        'dots dots dots';
      align-items: center;
      column-gap: 0.75rem;
      row-gap: 1.25rem;
    }

    .home-location__viewport {
      grid-area: viewport;
      overflow: hidden;
    }

    .home-location__track {
      gap: 0;
      padding-inline: 0;
      scroll-padding-inline: 0;
      scroll-snap-type: x mandatory;
    }

    .home-location__slide {
      flex: 0 0 100%;
      width: 100%;
      scroll-snap-align: center;
      scroll-snap-stop: always;
    }

    .home-location__nav {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 2.5rem;
      height: 2.5rem;
      margin: 0;
      padding: 0;
      border: 0;
      background: transparent;
      color: inherit;
      font-size: 1.75rem;
      line-height: 1;
      cursor: pointer;
    }

    .home-location__nav:disabled {
      opacity: 0.28;
      cursor: default;
    }

    .home-location__nav--prev {
      grid-area: prev;
    }

    .home-location__nav--next {
      grid-area: next;
    }

    .home-location__dots {
      grid-area: dots;
      margin-top: 0;
      padding-inline: 0;
    }
  }

  .home-location__grid {
    display: grid;
    gap: 1.75rem;
  }

  @media screen and (min-width: 750px) {
    .home-location__grid {
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
    }
  }

  .home-location__text {
    font-size: clamp(1rem, 1.5vw, 1.125rem);
    line-height: 1.75;
    letter-spacing: 0.02em;
  }

  .home-location__text p {
    margin: 0;
  }

  .home-location__link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: 2rem;
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 0.2em;
    font-size: 0.9rem;
    letter-spacing: 0.04em;
  }

  .home-location__link:hover {
    opacity: 0.7;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Home location",
  "tag": "div",
  "class": "section-home-location",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Visit the Shop"
    },
    {
      "type": "richtext",
      "id": "address",
      "label": "Address",
      "default": "<p>Winterfeldtstraße 13<br/>10781 Berlin</p>"
    },
    {
      "type": "richtext",
      "id": "hours",
      "label": "Opening hours",
      "default": "<p>Tue – Wed: 09:00–19:00<br/>Thu – Fri: 10:00–19:00<br/>Sat: 10:00–18:00<br/>Mon, Sun: Closed</p>"
    },
    {
      "type": "url",
      "id": "map_link",
      "label": "Map link"
    },
    {
      "type": "text",
      "id": "map_label",
      "label": "Map link label",
      "default": "Open in Maps"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Shop photo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Alt text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Home location"
    }
  ]
}
{% endschema %}
