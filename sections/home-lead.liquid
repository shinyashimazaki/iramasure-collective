<section class="home-lead color-{{ section.settings.color_scheme }}">
  <div class="home-lead__inner">
    {% if section.settings.heading != blank %}
      <h3 class="home-lead__heading">
        {%- assign heading_lines = section.settings.heading | split: '|' -%}
        {%- if heading_lines.size > 1 -%}
          {%- for line in heading_lines -%}
            {{- line | strip | escape -}}
            {%- unless forloop.last -%}<br class="home-lead__br">{%- endunless -%}
          {%- endfor -%}
        {%- else -%}
          {{- section.settings.heading | escape -}}
        {%- endif -%}
      </h3>
    {% endif %}

    {% if section.settings.body != blank %}
      <div class="home-lead__body rte">
        {{ section.settings.body }}
      </div>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .home-lead {
    padding: clamp(4.5rem, 10vw, 8rem) 1.5rem;
    background: var(--color-background);
    color: var(--color-foreground);
  }

  .home-lead__inner {
    max-width: 38rem;
    margin: 0 auto;
    text-align: left;
  }

  .home-lead__heading {
    margin: 0 0 2rem;
    font-family: var(--font-heading--family);
    font-size: clamp(1.35rem, 2.8vw, 1.85rem);
    font-weight: 400;
    line-height: 1.6;
    letter-spacing: 0.04em;
    text-align: left;
  }

  .home-lead__br {
    display: none;
  }

  @media screen and (max-width: 749px) {
    .home-lead__br {
      display: block;
    }
  }

  .home-lead__body {
    text-align: left;
    font-size: clamp(1.05rem, 1.7vw, 1.25rem);
    line-height: 1.6;
    letter-spacing: 0.03em;
  }

  .home-lead__body p {
    margin: 0 0 1.5em;
  }

  .home-lead__body p:last-child {
    margin-bottom: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Home lead",
  "tag": "div",
  "class": "section-home-lead",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Japanese sense of life,|right here in Berlin",
      "info": "Use | for a mobile-only line break."
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "default": "<p>IRAMASURE COLLECTIVEは、日本各地で丁寧につくられるもの——茶、器、織物、暮らしの道具——を選び、世界へ届ける場所です。</p><p>一口の抹茶にも、一本の帯にも、その土地の気候と、職人の手仕事が宿っています。<br>まだ知らない日本の風景へ。五感で旅をするように、良品と出会ってください。</p>"
    }
  ],
  "presets": [
    {
      "name": "Home lead"
    }
  ]
}
{% endschema %}
