{% liquid
  assign lead_heading = section.settings.heading
  if lead_heading == blank
    assign lead_heading = 'home.lead.heading' | t
  endif

  assign lead_body = section.settings.body | strip
  assign lead_body_plain = lead_body | strip_html | strip
  if lead_body == blank or lead_body_plain == blank
    assign lead_body = 'home.lead.body_html' | t
  endif
%}

<section class="home-lead color-{{ section.settings.color_scheme }}">
  <div class="home-lead__inner">
    {% if lead_heading != blank %}
      <h3 class="home-lead__heading">{{ lead_heading | escape }}</h3>
    {% endif %}

    {% if lead_body != blank %}
      <div class="home-lead__body rte">
        {{ lead_body }}
      </div>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .home-lead {
    padding: clamp(4.5rem, 10vw, 8rem) 1.5rem;
    background: var(--color-background);
    color: var(--color-foreground);
  }

  .home-lead__inner {
    max-width: 38rem;
    margin: 0 auto;
    text-align: center;
  }

  .home-lead__heading {
    margin: 0 0 2rem;
    font-family: var(--font-heading--family);
    font-size: clamp(1.35rem, 2.8vw, 1.85rem);
    font-weight: 400;
    line-height: 1.6;
    letter-spacing: 0.04em;
  }

  .home-lead__body {
    font-size: clamp(0.95rem, 1.5vw, 1.05rem);
    line-height: 2;
    letter-spacing: 0.03em;
  }

  .home-lead__body p {
    margin: 0 0 1.5em;
  }

  .home-lead__body p:last-child {
    margin-bottom: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Home lead",
  "tag": "div",
  "class": "section-home-lead",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": ""
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "default": "<p></p>"
    }
  ],
  "presets": [
    {
      "name": "Home lead"
    }
  ]
}
{% endschema %}
