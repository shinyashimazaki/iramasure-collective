<section class="home-feature color-{{ section.settings.color_scheme }}">
  {% if section.settings.heading != blank or section.settings.body != blank %}
    <div class="home-feature__copy">
      {% if section.settings.heading != blank %}
        <h3 class="home-feature__heading">{{ section.settings.heading | escape }}</h3>
      {% endif %}

      {% if section.settings.body != blank %}
        <div class="home-feature__body rte">
          {{ section.settings.body }}
        </div>
      {% endif %}
    </div>
  {% endif %}

  {% if section.settings.image != blank %}
    {% assign feature_alt = section.settings.image.alt | default: section.settings.heading %}
    <figure class="home-feature__figure">
      {{
        section.settings.image
        | image_url: width: 2400
        | image_tag:
          class: 'home-feature__image',
          widths: '800, 1200, 1600, 2400',
          sizes: '(min-width: 750px) min(67.5rem, 75vw), 100vw',
          loading: 'lazy',
          alt: feature_alt
      }}
      {% if section.settings.caption != blank %}
        <figcaption class="home-feature__caption">{{ section.settings.caption | escape }}</figcaption>
      {% endif %}
    </figure>
  {% endif %}

  {% if section.settings.secondary_heading != blank or section.settings.secondary_body != blank %}
    <div class="home-feature__copy home-feature__secondary">
      {% if section.settings.secondary_heading != blank %}
        <h3 class="home-feature__heading">{{ section.settings.secondary_heading | escape }}</h3>
      {% endif %}
      {% if section.settings.secondary_body != blank %}
        <div class="home-feature__body rte">
          {{ section.settings.secondary_body }}
        </div>
      {% endif %}
    </div>
  {% endif %}
</section>

{% stylesheet %}
  .home-feature {
    padding-block: clamp(4rem, 9vw, 7rem);
    background: var(--color-background);
    color: var(--color-foreground);
  }

  /* Text stays narrow; image below breaks wider like WAZU */
  .home-feature__copy {
    max-width: 40rem;
    margin-inline: auto;
    padding-inline: var(--page-margin, 1.5rem);
    text-align: left;
  }

  .home-feature__heading {
    margin: 0 0 1.75rem;
    font-family: var(--font-heading--family);
    font-size: clamp(1.3rem, 2.6vw, 1.75rem);
    font-weight: 400;
    line-height: 1.55;
    letter-spacing: 0.04em;
    text-align: left;
  }

  .home-feature__body {
    text-align: left;
    font-size: clamp(1.05rem, 1.7vw, 1.25rem);
    line-height: 1.6;
    letter-spacing: 0.03em;
  }

  .home-feature__body p {
    margin: 0 0 1.4em;
  }

  .home-feature__body p:last-child {
    margin-bottom: 0;
  }

  .home-feature__figure {
    /* Match journey / WAZU content photos: ~75vw band, ~2:1 like WAZU landscapes */
    width: min(67.5rem, calc(100% - 2 * max(var(--page-margin, 1.5rem), 12.5vw)));
    max-width: 100%;
    margin: clamp(3rem, 6vw, 4.5rem) auto;
    aspect-ratio: 2 / 1;
    overflow: hidden;
  }

  .home-feature__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  @media screen and (max-width: 749px) {
    .home-feature__figure {
      /* Slightly taller on small screens so the crop doesn’t feel too thin */
      aspect-ratio: 16 / 9;
      width: calc(100% - 2 * var(--page-margin, 1.25rem));
    }
  }

  .home-feature__caption {
    margin-top: 0.85rem;
    padding-inline: 0.15rem;
    font-size: 0.8rem;
    letter-spacing: 0.06em;
    opacity: 0.7;
  }

  .home-feature__secondary {
    margin-top: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Home feature",
  "tag": "div",
  "class": "section-home-feature",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "土地の個性を、そのままに。"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "default": "<p>私たちは、派手な加工や流行の装飾よりも、素材そのものの表情と、作り手の息づかいを大切にしています。<br>茶葉の香り、器の釉薬、帯地の織り目——余分なものを削ぎ落とすほど、その土地でしか生まれない個性が立ち上がります。</p><p>同じものは、ふたつとありません。<br>だからこそ、出会いは一期一会。手にした瞬間の感覚を、逃さないでほしい。</p>"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "caption",
      "label": "Image caption"
    },
    {
      "type": "text",
      "id": "secondary_heading",
      "label": "Secondary heading",
      "default": "まだ知らない日本に出会える。"
    },
    {
      "type": "richtext",
      "id": "secondary_body",
      "label": "Secondary body",
      "default": "<p>日本には、世代を超えて技を守る工房もあれば、新しい感性で伝統を編み直す作り手もいます。<br>大きな名声の陰で、静かに、笑いながら、自分の道を貫く人たちがいる。</p><p>IRAMASURE COLLECTIVEは、そうした良品を見つけ、物語ごと届けるために旅を続けています。</p>"
    }
  ],
  "presets": [
    {
      "name": "Home feature"
    }
  ]
}
{% endschema %}
