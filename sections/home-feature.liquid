{% liquid
  assign feature_heading = section.settings.heading
  if feature_heading == blank
    assign feature_heading = 'home.feature.heading' | t
  endif

  assign feature_body = section.settings.body | strip
  assign feature_body_plain = feature_body | strip_html | strip
  if feature_body == blank or feature_body_plain == blank
    assign feature_body = 'home.feature.body_html' | t
  endif

  assign feature_secondary_heading = section.settings.secondary_heading
  if feature_secondary_heading == blank
    assign feature_secondary_heading = 'home.feature.secondary_heading' | t
  endif

  assign feature_secondary_body = section.settings.secondary_body | strip
  assign feature_secondary_plain = feature_secondary_body | strip_html | strip
  if feature_secondary_body == blank or feature_secondary_plain == blank
    assign feature_secondary_body = 'home.feature.secondary_body_html' | t
  endif
%}

<section class="home-feature color-{{ section.settings.color_scheme }}">
  <div class="home-feature__inner">
    {% if feature_heading != blank %}
      <h3 class="home-feature__heading">{{ feature_heading | escape }}</h3>
    {% endif %}

    {% if feature_body != blank %}
      <div class="home-feature__body rte">
        {{ feature_body }}
      </div>
    {% endif %}

    {% if section.settings.image != blank %}
      {% assign feature_alt = section.settings.image.alt | default: feature_heading %}
      <figure class="home-feature__figure">
        {{
          section.settings.image
          | image_url: width: 2400
          | image_tag:
            class: 'home-feature__image',
            widths: '800, 1200, 1600, 2400',
            sizes: '(min-width: 900px) 70vw, 100vw',
            loading: 'lazy',
            alt: feature_alt
        }}
        {% if section.settings.caption != blank %}
          <figcaption class="home-feature__caption">{{ section.settings.caption | escape }}</figcaption>
        {% endif %}
      </figure>
    {% endif %}

    {% if feature_secondary_heading != blank or feature_secondary_body != blank %}
      <div class="home-feature__secondary">
        {% if feature_secondary_heading != blank %}
          <h3 class="home-feature__heading">{{ feature_secondary_heading | escape }}</h3>
        {% endif %}
        {% if feature_secondary_body != blank %}
          <div class="home-feature__body rte">
            {{ feature_secondary_body }}
          </div>
        {% endif %}
      </div>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .home-feature {
    padding: clamp(4rem, 9vw, 7rem) 1.5rem;
    background: var(--color-background);
    color: var(--color-foreground);
  }

  .home-feature__inner {
    max-width: 40rem;
    margin: 0 auto;
    text-align: center;
  }

  .home-feature__heading {
    margin: 0 0 1.75rem;
    font-family: var(--font-heading--family);
    font-size: clamp(1.3rem, 2.6vw, 1.75rem);
    font-weight: 400;
    line-height: 1.55;
    letter-spacing: 0.04em;
  }

  .home-feature__body {
    font-size: clamp(0.95rem, 1.45vw, 1.05rem);
    line-height: 2;
    letter-spacing: 0.03em;
  }

  .home-feature__body p {
    margin: 0 0 1.4em;
  }

  .home-feature__body p:last-child {
    margin-bottom: 0;
  }

  .home-feature__figure {
    margin: 3.5rem 0;
  }

  .home-feature__image {
    width: 100%;
    height: auto;
    display: block;
  }

  .home-feature__caption {
    margin-top: 0.85rem;
    font-size: 0.8rem;
    letter-spacing: 0.06em;
    opacity: 0.7;
  }

  .home-feature__secondary {
    margin-top: 3rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Home feature",
  "tag": "div",
  "class": "section-home-feature",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": ""
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "default": "<p></p>"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "caption",
      "label": "Image caption"
    },
    {
      "type": "text",
      "id": "secondary_heading",
      "label": "Secondary heading",
      "default": ""
    },
    {
      "type": "richtext",
      "id": "secondary_body",
      "label": "Secondary body",
      "default": "<p></p>"
    }
  ],
  "presets": [
    {
      "name": "Home feature"
    }
  ]
}
{% endschema %}
