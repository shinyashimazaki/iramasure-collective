{%- doc -%}
  Full-width collection header banner using the collection image from admin.
{%- enddoc -%}

{% liquid
  assign banner_image = collection.image
  assign banner_ratio = section.settings.image_ratio
%}

{% if banner_image != blank %}
  <div
    class="collection-banner color-{{ section.settings.color_scheme }} section-wrapper"
    {{ section.shopify_attributes }}
  >
    <div
      class="collection-banner__media"
      style="--collection-banner-ratio: {{ banner_ratio }};"
    >
      {{
        banner_image
        | image_url: width: 2880
        | image_tag:
          class: 'collection-banner__image',
          widths: '750, 1100, 1500, 1780, 2000, 2400, 2880',
          sizes: '100vw',
          loading: 'eager',
          fetchpriority: 'high',
          alt: collection.title
      }}
    </div>
  </div>
{% endif %}

{% stylesheet %}
  .collection-banner {
    width: 100%;
  }

  .collection-banner__media {
    width: 100%;
    overflow: hidden;
    aspect-ratio: var(--collection-banner-ratio, 3 / 1);
  }

  .collection-banner__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  @media screen and (max-width: 749px) {
    .collection-banner__media {
      aspect-ratio: 16 / 9;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.collection_image",
  "tag": "section",
  "class": "section-collection-banner",
  "settings": [
    {
      "type": "paragraph",
      "content": "t:content.resource_reference_collection_card_image"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "t:settings.ratio",
      "options": [
        {
          "value": "21 / 9",
          "label": "t:options.landscape"
        },
        {
          "value": "3 / 1",
          "label": "3:1"
        },
        {
          "value": "16 / 9",
          "label": "16:9"
        },
        {
          "value": "2 / 1",
          "label": "2:1"
        }
      ],
      "default": "3 / 1"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "t:names.collection_image"
    }
  ]
}
{% endschema %}
