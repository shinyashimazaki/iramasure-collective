<section class="home-journey color-{{ section.settings.color_scheme }}">
  <div class="home-journey__track" data-home-journey-track>
    {% for block in section.blocks %}
      {% liquid
        assign product = block.settings.product
        assign card_title = block.settings.title
        assign card_place = block.settings.place
        assign card_link = block.settings.link
        assign card_image = block.settings.image

        if product != blank
          if card_title == blank
            assign card_title = product.title
          endif
          if card_link == blank
            assign card_link = product.url
          endif
          if card_image == blank
            assign card_image = product.featured_image
          endif
        endif
      %}

      <article class="home-journey__card" {{ block.shopify_attributes }}>
        <div class="home-journey__media">
          {% if card_image != blank %}
            {{
              card_image
              | image_url: width: 1600
              | image_tag:
                class: 'home-journey__image',
                widths: '600, 900, 1200, 1600',
                sizes: '(min-width: 900px) 42vw, 88vw',
                loading: 'lazy',
                alt: card_title
            }}
          {% else %}
            {{ 'product-apparel-1' | placeholder_svg_tag: 'home-journey__image' }}
          {% endif %}
        </div>

        <div class="home-journey__meta">
          <p class="home-journey__name">
            {% if card_title != blank %}
              <span class="home-journey__title">{{ card_title | escape }}</span>
            {% endif %}
            {% if card_place != blank %}
              <span class="home-journey__place">（{{ card_place | escape }}）</span>
            {% endif %}
          </p>

          {% if card_link != blank %}
            <a class="home-journey__link" href="{{ card_link }}">
              {{ section.settings.cta_label | escape }}
            </a>
          {% endif %}
        </div>
      </article>
    {% endfor %}
  </div>
</section>

{% stylesheet %}
  .home-journey {
    position: relative;
    padding: clamp(3.5rem, 8vw, 6rem) 0;
    background: var(--color-background);
    color: var(--color-foreground);
  }

  .home-journey__track {
    display: flex;
    gap: 1rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding: 0 clamp(1.25rem, 4vw, 2.5rem) 0.5rem;
    scrollbar-width: thin;
  }

  .home-journey__card {
    flex: 0 0 min(78vw, 28rem);
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: transparent;
    color: inherit;
  }

  .home-journey__media {
    position: relative;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background: #111;
  }

  .home-journey__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .home-journey__meta {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.85rem;
    padding: 1.25rem 0.75rem 0;
    text-align: center;
  }

  .home-journey__name {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: 1.05rem;
    letter-spacing: 0.06em;
  }

  .home-journey__title {
    display: inline;
  }

  .home-journey__place {
    opacity: 0.85;
  }

  .home-journey__link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.5rem;
    padding: 0 1.35rem;
    border: 1px solid currentColor;
    color: inherit;
    text-decoration: none;
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }

  .home-journey__link:hover {
    background: var(--color-foreground);
    color: var(--color-background);
    border-color: var(--color-foreground);
  }

  @media screen and (max-width: 749px) {
    .home-journey__track {
      padding-left: 1.25rem;
      padding-right: 1.25rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Home journey",
  "tag": "div",
  "class": "section-home-journey",
  "max_blocks": 6,
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "詳しく見る"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Product stop",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Background image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title override"
        },
        {
          "type": "text",
          "id": "place",
          "label": "Place",
          "default": "京都"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link override"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Home journey",
      "blocks": [
        { "type": "item" },
        { "type": "item" },
        { "type": "item" }
      ]
    }
  ]
}
{% endschema %}
