<section class="home-journey color-{{ section.settings.color_scheme }}">
  <div class="home-journey__carousel" data-home-journey>
    <button
      type="button"
      class="home-journey__nav home-journey__nav--prev"
      data-home-journey-prev
      aria-label="{{ 'accessibility.slideshow_previous' | t }}"
    >
      <span aria-hidden="true">‹</span>
    </button>

    <div class="home-journey__track" data-home-journey-track>
      {% for block in section.blocks %}
        {% liquid
          assign product = block.settings.product
          assign card_title = block.settings.title
          assign card_place = block.settings.place
          assign card_link = block.settings.link
          assign card_image = block.settings.image

          if product != blank
            if card_title == blank
              assign card_title = product.title
            endif
            if card_link == blank
              assign card_link = product.url
            endif
            if card_image == blank
              assign card_image = product.featured_image
            endif
          endif
        %}

        <article class="home-journey__card" {{ block.shopify_attributes }}>
          <div class="home-journey__media">
            {% if card_image != blank %}
              {{
                card_image
                | image_url: width: 1600
                | image_tag:
                  class: 'home-journey__image',
                  widths: '600, 900, 1200, 1600',
                  sizes: '(min-width: 900px) 30vw, 78vw',
                loading: 'lazy',
                alt: card_title
            }}
            {% else %}
              {{ 'product-apparel-1' | placeholder_svg_tag: 'home-journey__image' }}
            {% endif %}
          </div>

          <div class="home-journey__meta">
            <p class="home-journey__name">
              {% if card_title != blank %}
                <span class="home-journey__title">{{ card_title | escape }}</span>
              {% endif %}
              {% if card_place != blank %}
                <span class="home-journey__place">（{{ card_place | escape }}）</span>
              {% endif %}
            </p>

            {% if card_link != blank %}
              <a class="home-journey__link" href="{{ card_link }}">
                {{ section.settings.cta_label | escape }}
              </a>
            {% endif %}
          </div>
        </article>
      {% endfor %}
    </div>

    <button
      type="button"
      class="home-journey__nav home-journey__nav--next"
      data-home-journey-next
      aria-label="{{ 'accessibility.slideshow_next' | t }}"
    >
      <span aria-hidden="true">›</span>
    </button>
  </div>
</section>

<script src="{{ 'home-journey.js' | asset_url }}" defer></script>

{% stylesheet %}
  .home-journey {
    position: relative;
    padding: clamp(3.5rem, 8vw, 6rem) 0;
    background: var(--color-background);
    color: var(--color-foreground);
  }

  .home-journey__carousel {
    position: relative;
  }

  .home-journey__track {
    display: flex;
    gap: 1rem;
    padding: 0 clamp(1.25rem, 4vw, 2.5rem);
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .home-journey__track::-webkit-scrollbar {
    display: none;
  }

  .home-journey__card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: transparent;
    color: inherit;
  }

  /* Desktop: three cards centered, no carousel */
  @media screen and (min-width: 750px) {
    .home-journey__track {
      justify-content: center;
      max-width: min(72rem, calc(100% - 3rem));
      margin-inline: auto;
      overflow: visible;
      cursor: default;
    }

    .home-journey__card {
      flex: 1 1 0;
      max-width: 22rem;
      min-width: 0;
    }

    .home-journey__nav {
      display: none;
    }
  }

  /* Mobile: horizontal scroll carousel */
  @media screen and (max-width: 749px) {
    .home-journey__track {
      overflow-x: auto;
      overflow-y: hidden;
      scroll-snap-type: x mandatory;
      scroll-behavior: smooth;
      cursor: grab;
      touch-action: pan-y;
      -webkit-overflow-scrolling: touch;
      padding-left: 1.25rem;
      padding-right: 1.25rem;
    }

    .home-journey__track.is-dragging {
      cursor: grabbing;
      scroll-behavior: auto;
      scroll-snap-type: none;
      user-select: none;
    }

    .home-journey__card {
      flex: 0 0 min(78vw, 20rem);
      scroll-snap-align: start;
    }
  }

  .home-journey__media {
    position: relative;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background: #111;
  }

  .home-journey__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    pointer-events: none;
  }

  .home-journey__meta {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.85rem;
    padding: 1.25rem 0.75rem 0;
    text-align: center;
  }

  .home-journey__name {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: 1.05rem;
    letter-spacing: 0.06em;
  }

  .home-journey__title {
    display: inline;
  }

  .home-journey__place {
    opacity: 0.85;
  }

  .home-journey__link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.5rem;
    padding: 0 1.35rem;
    border: 1px solid currentColor;
    color: inherit;
    text-decoration: none;
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }

  .home-journey__link:hover {
    background: var(--color-foreground);
    color: var(--color-background);
    border-color: var(--color-foreground);
  }

  .home-journey__nav {
    position: absolute;
    top: calc((min(78vw, 22rem) * 4 / 3) / 2);
    z-index: 2;
    transform: translateY(-50%);
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid color-mix(in srgb, var(--color-foreground) 25%, transparent);
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-background) 88%, transparent);
    color: var(--color-foreground);
    font-size: 1.5rem;
    line-height: 1;
    display: grid;
    place-items: center;
    cursor: pointer;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease, background 0.2s ease;
  }

  .home-journey__carousel.is-scrollable .home-journey__nav {
    opacity: 1;
    pointer-events: auto;
  }

  .home-journey__nav:disabled {
    opacity: 0.35;
    cursor: default;
  }

  .home-journey__nav--prev {
    left: 0.75rem;
  }

  .home-journey__nav--next {
    right: 0.75rem;
  }

  .home-journey__nav:not(:disabled):hover {
    background: var(--color-background);
  }

  @media screen and (max-width: 749px) {
    .home-journey__nav {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-journey__track {
      scroll-behavior: auto;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Home journey",
  "tag": "div",
  "class": "section-home-journey",
  "max_blocks": 6,
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "詳しく見る"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Product stop",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Background image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title override"
        },
        {
          "type": "text",
          "id": "place",
          "label": "Place",
          "default": "京都"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link override"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Home journey",
      "blocks": [
        { "type": "item" },
        { "type": "item" },
        { "type": "item" }
      ]
    }
  ]
}
{% endschema %}
